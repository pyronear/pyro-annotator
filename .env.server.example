# Server deployment env — copy to .env next to docker-compose.server.yml and
# replace every CHANGEME with `openssl rand -hex 24`. Never commit the real .env.

# PostgreSQL (never published on the host)
POSTGRES_USER=pyro
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=pyro_annotator

# Bootstrap admin user for the annotation API
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGEME
JWT_SECRET=CHANGEME

# MinIO root credentials (interim storage)
MINIO_ROOT_USER=pyrominio
MINIO_ROOT_PASSWORD=CHANGEME

# S3 settings as seen by the API/worker.
# While on MinIO: S3_ACCESS_KEY/S3_SECRET_KEY MUST equal MINIO_ROOT_USER/MINIO_ROOT_PASSWORD,
# and S3_PROXY_URL rewrites presigned URLs to the public MinIO address for browsers.
# When the real bucket lands: point these at it and set S3_PROXY_URL= (empty).
S3_ENDPOINT_URL=http://minio:4566
S3_ACCESS_KEY=pyrominio
S3_SECRET_KEY=CHANGEME
S3_REGION=us-east-1
S3_BUCKET_NAME=annotation-api
S3_PROXY_URL=http://162.19.113.48:4566

# Public API origin baked into the frontend at build time (no /api/v1 suffix —
# the frontend appends it).
VITE_API_BASE_URL=http://162.19.113.48:5050
